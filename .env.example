# Jazz YUL Operations (copy to .env.local)

# Mock Jazz/YUL traffic. No FR24 credits are used.
NEXT_PUBLIC_DEMO_MODE=true

# Official FR24 API token from https://fr24api.flightradar24.com/key-management
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
FR24_API_KEY=

# Optional Cesium ion token for imagery/terrain. The globe works without it.
CESIUM_ION_TOKEN=

# Poll / cache interval in milliseconds. Explorer 24/7 use needs a high value.
# See README "Flightradar24 Explorer".
FR24_REFRESH_INTERVAL=120000

# Remove an aircraft only after this many ms without a fresh snapshot.
FR24_STALE_MS=900000
